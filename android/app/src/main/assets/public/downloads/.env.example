# ============================================================================
# BLOODSEARCH PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your Cloud Run / Render / Railway / Vercel secret manager.
# NEVER commit real `.env` secrets or private keystores to version control.
# ============================================================================

NODE_ENV="production"
PORT="3000"

# 1. NEON SERVERLESS POSTGRESQL (PRIMARY & ONLY DATABASE)
# Pooled endpoint (`-pooler`) for runtime API queries (TLS verify-full required in production):
DATABASE_URL="postgresql://bloodsearch_app_runtime:YOUR_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# Direct unpooled endpoint for `npm run db:migrate` & logical backups:
DIRECT_DATABASE_URL="postgresql://bloodsearch_migrator:YOUR_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# Optional pool tuning
DB_POOL_MAX="10"
DB_CONNECT_TIMEOUT_MS="8000"
DB_IDLE_TIMEOUT_MS="20000"
DB_STATEMENT_TIMEOUT_MS="10000"

# 2. GOOGLE IDENTITY SERVICES (GIS) / GOOGLE OIDC AUTHENTICATION
# Create an OAuth 2.0 Web Client in Google Cloud Console -> APIs & Services -> Credentials.
# Authorized Redirect URIs must include `<APP_URL>/auth/callback`.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_WEB_CLIENT_SECRET"

# Optional frontend GIS One-Tap / Button Client ID (public identifier, safe with VITE_ prefix)
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"

# 3. APPLICATION ORIGIN, CORS ALLOWLIST & SUPER OWNER GOVERNANCE
APP_URL="https://your-production-domain.example.com"
ALLOWED_ORIGINS="https://your-production-domain.example.com,capacitor://localhost,https://localhost"
SUPER_ADMIN_EMAIL="shamimrakib015@gmail.com"

# Server-side HMAC salt used to hash IP addresses and audit identifiers (generate 32+ random hex bytes)
AUDIT_IP_SALT="GENERATE_64_HEX_CHAR_RANDOM_SECRET_HERE"
OTP_HMAC_SECRET="GENERATE_64_HEX_CHAR_RANDOM_OTP_SECRET_HERE"

# 4. OPTIONAL BTRC-COMPLIANT BANGLADESH SMS OTP GATEWAY
# Options: NONE | W3SMS | ZENDSMS | BTRC_CUSTOM
SMS_GATEWAY_PROVIDER="NONE"
SMS_GATEWAY_API_URL=""
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID="BloodSearch"

# 5. OPTIONAL ANDROID APK RELEASE SIGNING (CI / LOCAL GRADLE BUILD ONLY)
ANDROID_KEYSTORE_PATH=""
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS=""
ANDROID_KEY_PASSWORD=""

# 6. OPTIONAL CAPACITOR REMOTE API BASE URL (Leave empty when served from same origin, or set HTTPS API host for standalone APK builds)
VITE_API_BASE_URL=""
