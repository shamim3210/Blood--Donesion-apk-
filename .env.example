# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHITE-LABEL COMMERCIAL BRANDING & OWNERSHIP (Optional — defaults to BloodSearch)
VITE_BRAND_NAME="BloodSearch"
VITE_BRAND_TAGLINE="FIND BLOOD. SAVE LIFE."
VITE_ORG_NAME="Bangladesh Emergency Blood Network"
VITE_SUPPORT_PHONE="16263"
VITE_SUPPORT_EMAIL="support@bloodsearch.org"
VITE_SUPER_ADMIN_EMAIL=""
VITE_DEFAULT_REAL_ONLY_MODE="true"

# ANDROID APK / TWA DIGITAL ASSET LINKS ANTI-TAMPER VERIFICATION (Server-Only)
# Set your Play Store / Bubblewrap signing key SHA-256 fingerprint (colon-separated hex)
# so /.well-known/assetlinks.json cryptographically binds your domain exclusively to your signed APK.
ANDROID_APK_PACKAGE_NAME="bd.bloodsearch.app"
ANDROID_APK_SHA256_FINGERPRINT=""

# VITE_RECAPTCHA_V3_SITE_KEY: Optional public reCAPTCHA v3 Site Key for Firebase App Check.
# When set in Vercel/Hosting environment variables, automatically activates App Check
# attestation to block non-browser bots, scripts, and unauthorized API scrapers.
VITE_RECAPTCHA_V3_SITE_KEY=""

# VITE_FIREBASE_VAPID_KEY: Optional public Web Push VAPID key from Firebase Console -> Cloud Messaging.
# Required to issue real Firebase Cloud Messaging (FCM) browser push tokens.
VITE_FIREBASE_VAPID_KEY=""

# FCM_SERVER_KEY: Optional server-side Firebase Cloud Messaging credential / OAuth bearer for background push.
# Never expose in client code; read exclusively by server.ts.
FCM_SERVER_KEY=""

# SMS_PROVIDER: Legitimate SMS fallback provider ("NONE" | "TWILIO" | "WEBHOOK_BD").
# Keep "NONE" until real provider credentials are configured in server secrets.
SMS_PROVIDER="NONE"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_API_KEY=""

# ============================================================================
# BLOODSEARCH OTP AUTHENTICATION & FUTURE BANGLADESH SMS GATEWAY (Server-Only)
# ============================================================================
# Zero-cost development mode: keep OTP_SMS_PROVIDER="NONE".
# Note: Dev OTP Sandbox is automatically DISABLED whenever NODE_ENV="production".
ENABLE_DEV_OTP_SANDBOX="true"
OTP_HMAC_SECRET=""

# Future Real Bangladesh SMS Gateway Selection ("NONE" | "W3SMS" | "ZENDSMS" | "BTRC_CUSTOM")
# Keep "NONE" during free development so zero paid APIs are called.
OTP_SMS_PROVIDER="NONE"

# W3 SMS Bangladesh (Server-side only — never prefix with VITE_)
W3SMS_API_URL=""
W3SMS_API_KEY=""
W3SMS_SENDER_ID=""

# ZendSMS Bangladesh (Server-side only — never prefix with VITE_)
ZENDSMS_API_URL=""
ZENDSMS_API_KEY=""
ZENDSMS_SENDER_ID=""

# Generic BTRC-Compliant Bangladesh SMS Gateway (SSL Wireless, BulkSMSBD, etc.)
BTRC_SMS_API_URL=""
BTRC_SMS_API_KEY=""
BTRC_SMS_SENDER_ID=""

# Optional Firebase Service Account JSON (Server-side only — used in production when
# OTP_SMS_PROVIDER is enabled to mint RS256 Firebase Custom Tokens via verifyOtp,
# and during controlled Firestore-to-Neon migration scripts).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ============================================================================
# NEON POSTGRESQL PRIMARY APPLICATION DATABASE (Server-Only — NEVER use VITE_)
# ============================================================================
# DATABASE_URL: Pooled Neon PostgreSQL connection string (`-pooler` hostname) with TLS verify-full.
# Used exclusively by the Express backend (`server.ts`) for runtime queries & transactions.
# Example format (NEVER commit real credentials):
# DATABASE_URL="postgresql://bloodsearch_app:YOUR_STRONG_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL=""

# DIRECT_DATABASE_URL: Direct unpooled Neon connection string (no `-pooler` suffix) with TLS verify-full.
# Used exclusively for Drizzle DDL schema migrations (`npm run db:migrate`) and `pg_dump` backups.
# DIRECT_DATABASE_URL="postgresql://neondb_owner:YOUR_OWNER_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_DATABASE_URL=""

# DB_CUTOVER_MODE: Controlled migration cutover state ("FIRESTORE_PRIMARY" | "MIGRATION_READ_VERIFY" | "NEON_PRIMARY").
# Keep "FIRESTORE_PRIMARY" until `npm run db:verify-migration` passes 100%, then switch to "NEON_PRIMARY".
DB_CUTOVER_MODE="FIRESTORE_PRIMARY"

# NEON_PLAN_TIER: Current Neon subscription tier ("FREE" | "LAUNCH" | "SCALE") for storage & cold-start monitoring.
NEON_PLAN_TIER="FREE"

# DB_POOL_MAX: Maximum Express backend connections to the Neon `-pooler` PgBouncer endpoint (default: 10).
DB_POOL_MAX="10"

