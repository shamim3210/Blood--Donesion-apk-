        },
        "participantTwoUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Second participant Firebase Auth UID."
        },
        "participantTwoName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Second participant display name."
        },
        "participantTwoGroup": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"],
          "maxLength": 4,
          "description": "Second participant blood group."
        },
        "participantTwoAvatar": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000,
          "description": "Second participant avatar."
        },
        "participantTwoWhatsapp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24,
          "description": "Second participant WhatsApp number shared privately in this room."
        },
        "participantTwoFb": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Second participant Facebook URL shared privately in this room."
        },
        "lastMessage": {
          "type": "string",
          "minLength": 0,
