        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable room creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Latest activity server timestamp."
        }
      },
      "required": [
        "participantOneUid",
        "participantOneName",
        "participantOneGroup",
        "participantOneAvatar",
        "participantOneWhatsapp",
        "participantOneFb",
        "participantTwoUid",
        "participantTwoName",
        "participantTwoGroup",
        "participantTwoAvatar",
        "participantTwoWhatsapp",
        "participantTwoFb",
        "lastMessage",
        "lastSenderUid",
        "createdAt",
        "updatedAt"
