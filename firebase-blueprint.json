          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"],
          "maxLength": 4,
          "description": "Sender blood group badge."
        },
        "senderAvatar": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000,
          "description": "Sender avatar URL or compressed data URI."
        },
        "senderDistrict": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50,
