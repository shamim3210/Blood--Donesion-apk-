        },
        "replyToText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Quoted message snippet if replying."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Explicit query boundary guard."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        }
      },
      "required": [
        "senderUid",
        "senderName",
        "senderBloodGroup",
        "senderAvatar",
        "senderDistrict",
        "text",
        "replyToName",
        "replyToText",
        "isPublic",
        "createdAt"
      ]
    },
    "DirectChatRoom": {
      "title": "DirectChatRoom",
      "description": "Private 1-to-1 WhatsApp-style user-to-user chat room isolated strictly to its two participants.",
      "type": "object",
      "properties": {
        "participantOneUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "First participant Firebase Auth UID."
        },
        "participantOneName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "First participant display name."
        },
        "participantOneGroup": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"],
          "maxLength": 4,
          "description": "First participant blood group."
        },
        "participantOneAvatar": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000,
          "description": "First participant avatar."
        },
        "participantOneWhatsapp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24,
          "description": "First participant WhatsApp number shared privately in this room."
        },
        "participantOneFb": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
