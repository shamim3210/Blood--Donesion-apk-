          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        }
      },
      "required": [
        "chatId",
        "senderUid",
        "senderName",
        "participantOneUid",
        "participantTwoUid",
        "text",
        "replyToText",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Isolated private user accounts and contact PII readable only by the document owner or verified Admins."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted Admin Panel roster created only with an active Owner-issued /adminInviteLocks/{proofHash} or by the bootstrapped Super Owner."
    },
    "/adminInviteLocks/{proofHash}": {
      "schema": { "$ref": "#/entities/AdminInviteLock" },
      "description": "Server-side dynamic Admin invite vault writable and listable exclusively by shamimrakib015@gmail.com."
    },
    "/donors/{donorId}": {
      "schema": { "$ref": "#/entities/DonorCard" },
      "description": "Publicly searchable voluntary blood donor cards isolated from raw PII."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/BloodRequestDoc" },
      "description": "Emergency SOS blood requests with terminal state locking."
    },
    "/bloodStock/{groupId}": {
      "schema": { "$ref": "#/entities/BloodStockDoc" },
      "description": "Hospital blood inventory counts writable strictly by verified Admins."
    },
    "/communityMessages/{messageId}": {
      "schema": { "$ref": "#/entities/CommunityChatMessage" },
      "description": "Real-time BloodSearch Bangladesh community live chat stream isolated from raw phone PII."
    },
    "/directChats/{chatId}": {
      "schema": { "$ref": "#/entities/DirectChatRoom" },
      "description": "Private 1-to-1 user-to-user WhatsApp-style chat rooms accessible strictly to participantOneUid or participantTwoUid."
    },
    "/directChats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectChatMessage" },
      "description": "Private 1-to-1 user-to-user chat messages protected by parent DirectChatRoom Master Gate and participant UID query enforcement."
    }
  }
}
